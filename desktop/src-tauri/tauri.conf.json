{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lynk",
  "version": "0.1.0",
  "identifier": "lynk",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Lynk Client",
        "width": 735,
        "height": 600,
        "minWidth": 735,
        "maxWidth": 735,
        "minHeight": 400,
        "maximizable": false,
        "minimizable": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["lynk"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
