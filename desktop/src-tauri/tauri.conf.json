{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lynk",
  "version": "0.1.0",
  "identifier": "lynk",
  "build": {
    "beforeDevCommand": "node scripts/build-sidecar.mjs",
    "beforeBuildCommand": "node scripts/build-sidecar.mjs",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Lynk Client",
        "width": 735,
        "height": 600,
        "minWidth": 735,
        "maxWidth": 735,
        "minHeight": 400,
        "maximizable": false,
        "minimizable": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["lynk"]
      }
    },
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/Project-Shaww/Lynk/releases/latest/download/updater.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY2ODBGNUQyOEM0QTlBMTEKUldRUm1rcU0wdldBWmlVRzJpVVF0am8zSUp5ZENYVTZ1L0IrTk1taEFweDZCMXVGbEFjSjBvcFEK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/lynk_service"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
